<Window x:Class="bevasarlolista.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:bevasarlolista"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <ListBox x:Name="lb_lista" HorizontalAlignment="Left" Height="410" Margin="10,10,0,0" VerticalAlignment="Top" Width="350"/>
        <TextBox x:Name="tb_ujtermek" HorizontalAlignment="Left" Height="25" Margin="400,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="350"/>
        <Button x:Name="btn_hozzaad" Content="Hozzáadás" HorizontalAlignment="Left" Margin="400,45,0,0" VerticalAlignment="Top" Width="350" Height="30" Click="btn_hozzaad_Click" Background="LightGreen"/>
        <Button x:Name="btn_torles" Content="Törlés" HorizontalAlignment="Left" Margin="400,85,0,0" VerticalAlignment="Top" Width="350" Height="30" Click="btn_torles_Click" Background="LightCoral"/>
        <Button x:Name="btn_mindentTorol" Content="Összes elem törlése" HorizontalAlignment="Left" Margin="400,125,0,0" VerticalAlignment="Top" Width="350" Height="30" Click="btn_mindentTorol_Click" Background="Gray"/>
        <TextBlock x:Name="tb_ossz" HorizontalAlignment="Left" Margin="400,170,0,0" TextWrapping="Wrap" Text="Összes elem: 0" VerticalAlignment="Top" Height="30" Width="350"/>
    </Grid>
</Window>
